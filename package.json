{
  "name": "goosnav-font",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "wrangler deploy",
    "prebuild": "npm run assets",
    "deploy:check": "wrangler deploy --dry-run",
    "test:production": "playwright test -c playwright.production.config.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@techstark/opencv-js": "4.12.0-release.1",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "libheif-js": "1.23.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pyodide": "314.0.8",
    "qrcode": "1.5.4",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
